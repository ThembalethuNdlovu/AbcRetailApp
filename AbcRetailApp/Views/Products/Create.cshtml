@model ProductEntity
@{
    ViewData["Title"] = "Add Product";
    var images = ViewBag.AvailableImages as List<string> ?? new();
}

<h2>Add Product</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Product Name</label>
        <input asp-for="ProductName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Price</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Stock Quantity</label>
        <input asp-for="StockQuantity" type="number" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Product Image (optional — upload images via the Media page first)</label>
        <select asp-for="ImageBlobName" class="form-select">
            <option value="">-- No image --</option>
            @foreach (var img in images)
            {
                <option value="@img">@img</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>