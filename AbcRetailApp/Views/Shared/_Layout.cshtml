<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Retail</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-0">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop fs-4"></i>
                    <span>ABC Retail</span>
                </a>
                <div class="navbar-nav flex-row gap-1">
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                        <a class="nav-link" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Customers</a>
                        <a class="nav-link" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i> Products</a>
                        <a class="nav-link" asp-controller="Media" asp-action="Index"><i class="bi bi-images"></i> Media</a>
                        <a class="nav-link" asp-controller="Orders" asp-action="Index"><i class="bi bi-inboxes"></i> Orders</a>
                        <a class="nav-link" asp-controller="Logs" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Logs</a>
                    }
                    else if (User.IsInRole("Customer"))
                    {
                        <a class="nav-link" asp-controller="Catalog" asp-action="Index"><i class="bi bi-shop-window"></i> Shop</a>
                        <a class="nav-link" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart3"></i> Cart</a>
                        <a class="nav-link" asp-controller="Checkout" asp-action="History"><i class="bi bi-receipt"></i> My Orders</a>
                    }
                </div>
                <div class="navbar-nav flex-row ms-auto">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }
            @RenderBody()
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>