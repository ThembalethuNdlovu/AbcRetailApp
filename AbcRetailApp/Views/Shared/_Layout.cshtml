<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Retail</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">ABC Retail</a>
                <div class="navbar-nav">
                    <a class="nav-link" asp-controller="Customers" asp-action="Index">Customers (Table)</a>
                    <a class="nav-link" asp-controller="Products" asp-action="Index">Products (Table)</a>
                    <a class="nav-link" asp-controller="Media" asp-action="Index">Media (Blob)</a>
                    <a class="nav-link" asp-controller="Orders" asp-action="Index">Orders (Queue)</a>
                    <a class="nav-link" asp-controller="Logs" asp-action="Index">Logs (Files)</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }
            @RenderBody()
        </main>
    </div>
</body>
</html>