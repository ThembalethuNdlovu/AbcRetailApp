@{
    ViewData["Title"] = "Home";
}

<div class="hero-banner text-center">
    <h1><i class="bi bi-shop"></i> Welcome to ABC Retail</h1>
    <p>Cloud-powered retail — built on Azure Table, Blob, Queue, and File Storage.</p>
    @if (!User.Identity!.IsAuthenticated)
    {
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-light btn-lg mt-2 me-2">Get Started</a>
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-lg mt-2">Login</a>
    }
    else if (User.IsInRole("Admin"))
    {
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-lg mt-2">Go to Dashboard</a>
    }
    else
    {
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-light btn-lg mt-2">Start Shopping</a>
    }
</div>

@if (!User.Identity!.IsAuthenticated)
{
    <div class="row text-center">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <i class="bi bi-truck fs-1 text-primary"></i>
                    <h5 class="card-title mt-2">Fast Fulfillment</h5>
                    <p class="card-text text-muted">Orders processed reliably through Azure Queue Storage.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <i class="bi bi-images fs-1 text-primary"></i>
                    <h5 class="card-title mt-2">Rich Media</h5>
                    <p class="card-text text-muted">Product images served from scalable Azure Blob Storage.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <i class="bi bi-shield-check fs-1 text-primary"></i>
                    <h5 class="card-title mt-2">Secure Accounts</h5>
                    <p class="card-text text-muted">Role-based access with ASP.NET Core Identity.</p>
                </div>
            </div>
        </div>
    </div>
}